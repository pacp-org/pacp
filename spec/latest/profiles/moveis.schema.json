{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cdn.jsdelivr.net/npm/@pacp/spec@latest/dist/profiles/moveis.schema.json",
  "title": "PACP Profile: Moveis e Alta Decoracao",
  "description": "Extension profile para produtos de moveis e alta decoracao. Define campos x-* recomendados para o setor.",
  "type": "object",
  "properties": {
    "x-assembly_required": {
      "type": "boolean",
      "description": "Indica se o produto requer montagem."
    },
    "x-load_capacity": {
      "$ref": "https://cdn.jsdelivr.net/npm/@pacp/spec@latest/dist/pacp.schema.json#/$defs/measure",
      "description": "Capacidade de carga do movel (ex: {value: 50, unit: 'kg'})."
    },
    "x-material_composition": {
      "type": "string",
      "minLength": 1,
      "description": "Composicao principal do material (ex: 'MDF com laminado melaminico')."
    },
    "x-finish": {
      "type": "string",
      "minLength": 1,
      "description": "Acabamento superficial (ex: 'Lacado brilho', 'Nogueira natural')."
    },
    "x-warranty_months": {
      "type": "integer",
      "minimum": 0,
      "description": "Garantia em meses oferecida pelo fabricante."
    },
    "x-style": {
      "type": "string",
      "minLength": 1,
      "description": "Estilo do movel (ex: 'Contemporaneo', 'Classico', 'Industrial')."
    },
    "x-indoor_outdoor": {
      "type": "string",
      "enum": ["INDOOR", "OUTDOOR", "BOTH"],
      "description": "Indicacao de uso interno, externo ou ambos."
    },
    "x-fabric_requirements": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "min_weight_gsm": { "type": "number", "exclusiveMinimum": 0, "description": "Gramatura mínima do tecido (g/m²)." },
        "max_weight_gsm": { "type": "number", "exclusiveMinimum": 0, "description": "Gramatura máxima do tecido (g/m²)." },
        "min_width_cm": { "type": "number", "exclusiveMinimum": 0, "description": "Largura mínima do rolo (cm)." },
        "allowed_compositions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "description": "Composições aceitas (uppercase, ex: LINHO, ALGODAO, VELUDO)."
        },
        "abrasion_min_cycles_martindale": { "type": "integer", "minimum": 0, "description": "Resistência mínima à abrasão (ciclos Martindale)." },
        "flammability_standard": { "type": "string", "minLength": 1, "description": "Norma de inflamabilidade exigida (ex: NBR_15805)." }
      },
      "description": "Requisitos para tecido fornecido pelo cliente. Usado dentro de supplied_materials[].requirements."
    }
  },
  "additionalProperties": true
}
